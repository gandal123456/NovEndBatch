{
  "default": {

    "paths":
     [
      "src/features/**/*.feature"
    ],

    "require": 
    [
      "src/stepDefinitions/**/*.ts",
      "src/hooks/**/*.ts"
    ],

    "requireModule": 
    [
      "ts-node/register"
    ],

    "format": 
    [
      "progress",
      "json:reports/cucumber-report.json"
      
    ],
  
     

    "publishQuiet": true
  }
}